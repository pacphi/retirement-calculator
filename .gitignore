# Dependencies & package-manager state
node_modules/
.pnpm-store/
pnpm-debug.log*

# Build output
dist/

# Test coverage
coverage/

# Editor & OS cruft
.DS_Store

# Local secrets and per-developer instructions (Vite reads .env files; none are shared)
.env
.env.local
.env.*.local
CLAUDE.local.md

# AI agent tooling — machine-local state, caches, and databases.
# These are regenerated per machine/session and are not meant to be shared.
.agentic-qe/
.claude-flow/
# Ignore everything under .claude/ EXCEPT the project-specific skill(s) we author
# in this repo, which are version-controlled so they travel with the project.
# Using globs (not a bare `.claude/`) lets git descend so the negations apply.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/calculator-comparison/
.swarm/
ruvector.db

# Local MCP server configuration — may contain machine-specific paths or credentials.
.mcp.json
# Private learned stores and one machine's launchers: never commit them. AGENTS.md and CLAUDE.md stay tracked.
# Ruflo (claude-flow) runtime state and swarm stores
.hive-mind/
# AgentDB and RuVector stores
agentdb.rvf*
*.rvf
*.rvf.lock
*.rvf.manifest.json
# Launchers onboarding points at this machine's installs (D6, D11): per machine, never shared
.mcp.json.*
.codex/
# Leftover tool locks
.beads.gate.lock

# Audit/test scratch & generated reports (not part of the committed project)
/reports/
/.stryker-tmp/
/audits/
.autopilot/queued/
